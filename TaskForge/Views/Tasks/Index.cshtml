@model IEnumerable<TaskForge.ViewModels.TaskListViewModel>

@{
    ViewData["Title"] = "Tasks";
    Layout = "_DashboardLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2 class="fw-bold mb-1">Tasks</h2>
        <p class="text-muted mb-0">
            Manage your personal tasks.
        </p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i>
        Create Task
    </a>

</div>

<div class="card shadow-sm border-0">

    <div class="table-responsive">

        <table class="table table-hover align-middle mb-0">

            <thead class="table-light">

                <tr>

                    <th>Title</th>
                    <th>Category</th>
                    <th>Priority</th>
                    <th>Status</th>
                    <th>Due Date</th>
                    <th class="text-center" style="width:220px;">Actions</th>

                </tr>

            </thead>

            <tbody>

                @if (!Model.Any())
                {
                    <tr>

                        <td colspan="6" class="text-center py-5 text-muted">

                            No tasks yet.

                        </td>

                    </tr>
                }
                else
                {
                    @foreach (var task in Model)
                    {
                        <tr>

                            <td class="fw-semibold">
                                @task.Title
                            </td>

                            <td>
                                @task.Category
                            </td>

                            <td>

                                @if (task.Priority == "High")
                                {
                                    <span class="badge rounded-pill"
                                          style="background:#FEE2E2;color:#B91C1C;padding:8px 12px;">
                                        High
                                    </span>
                                }
                                else if (task.Priority == "Medium")
                                {
                                    <span class="badge rounded-pill"
                                          style="background:#FEF3C7;color:#B45309;padding:8px 12px;">
                                        Medium
                                    </span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill"
                                          style="background:#DCFCE7;color:#15803D;padding:8px 12px;">
                                        Low
                                    </span>
                                }

                            </td>

                            <td>

                                @if (task.Status == "Pending")
                                {
                                    <span class="badge rounded-pill"
                                          style="background:#FEF3C7;color:#B45309;padding:8px 12px;">
                                        Pending
                                    </span>
                                }
                                else if (task.Status == "In Progress")
                                {
                                    <span class="badge rounded-pill"
                                          style="background:#DBEAFE;color:#2563EB;padding:8px 12px;">
                                        In Progress
                                    </span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill"
                                          style="background:#DCFCE7;color:#15803D;padding:8px 12px;">
                                        Completed
                                    </span>
                                }

                            </td>

                            <td>
                                @task.DueDate.ToString("MMM dd, yyyy")
                            </td>

                            <td>
                                <div class="d-flex justify-content-center gap-2">

                                    <a asp-action="Details"
                                       asp-route-id="@task.TaskId"
                                       class="btn action-btn action-view"
                                       title="View">

                                        <i class="bi bi-eye"></i>

                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@task.TaskId"
                                       class="btn action-btn action-edit"
                                       title="Edit">

                                        <i class="bi bi-pencil-square"></i>

                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@task.TaskId"
                                       class="btn action-btn action-delete"
                                       title="Delete">

                                        <i class="bi bi-trash"></i>

                                    </a>

                                </div>

                            </td>

                        </tr>
                    }
                }

            </tbody>

        </table>

    </div>

</div>