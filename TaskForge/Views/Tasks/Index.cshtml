@model TaskForge.ViewModels.TaskIndexViewModel

@{
    ViewData["Title"] = "Tasks";
    Layout = "_DashboardLayout";
}

<!-- ==========================
     Page Header
========================== -->

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>

        <h2 class="fw-bold mb-1">
            Tasks
        </h2>

        <p class="text-muted mb-0">
            Manage your personal tasks.
        </p>

    </div>

    <a asp-action="Create"
       class="btn btn-primary">

        <i class="bi bi-plus-lg me-1"></i>

        Create Task

    </a>

</div>

<!-- ==========================
     Search & Filters
========================== -->

<div class="card shadow-sm border-0 mb-4">

    <div class="card-body">

        <form asp-action="Index" method="get">

            <div class="row g-3">

                <!-- Search -->

                <div class="col-lg-4">

                    <label asp-for="SearchString"
                           class="form-label fw-semibold">
                        Search
                    </label>

                    <div class="input-group">

                        <span class="input-group-text">
                            <i class="bi bi-search"></i>
                        </span>

                        <input asp-for="SearchString"
                               class="form-control"
                               placeholder="Search by task title..." />

                    </div>

                </div>

                <!-- Category -->

                <div class="col-lg-2">

                    <label asp-for="CategoryId"
                           class="form-label fw-semibold">
                        Category
                    </label>

                    <select asp-for="CategoryId"
                            asp-items="Model.Categories"
                            class="form-select">

                        <option value="">All Categories</option>

                    </select>

                </div>

                <!-- Priority -->

                <div class="col-lg-2">

                    <label asp-for="PriorityId"
                           class="form-label fw-semibold">
                        Priority
                    </label>

                    <select asp-for="PriorityId"
                            asp-items="Model.Priorities"
                            class="form-select">

                        <option value="">All Priorities</option>

                    </select>

                </div>

                <!-- Status -->

                <div class="col-lg-2">

                    <label asp-for="StatusId"
                           class="form-label fw-semibold">
                        Status
                    </label>

                    <select asp-for="StatusId"
                            asp-items="Model.Statuses"
                            class="form-select">

                        <option value="">All Statuses</option>

                    </select>

                </div>

                <!-- Sort -->

                <div class="col-lg-2">

                    <label asp-for="SortBy"
                           class="form-label fw-semibold">
                        Sort By
                    </label>

                    <select asp-for="SortBy"
                            class="form-select">

                        <option value="">
                            Due Date (Nearest)
                        </option>

                        <option value="due_desc">
                            Due Date (Latest)
                        </option>

                        <option value="title_asc">
                            Title (A–Z)
                        </option>

                        <option value="title_desc">
                            Title (Z–A)
                        </option>

                        <option value="priority">
                            Priority (High → Low)
                        </option>

                    </select>

                </div>

            </div>

            <hr class="my-4" />

            <div class="d-flex justify-content-end gap-2">

                <a asp-action="Index"
                   class="btn btn-outline-secondary">

                    <i class="bi bi-arrow-counterclockwise me-1"></i>

                    Reset

                </a>

                <button type="submit"
                        class="btn btn-primary">

                    <i class="bi bi-funnel-fill me-1"></i>

                    Apply Filters

                </button>

            </div>

        </form>

    </div>

</div>

<!-- ==========================
     Task Table
========================== -->

<div class="card shadow-sm border-0">

    <div class="table-responsive">

        <table class="table table-hover align-middle mb-0">

            <thead class="table-light">

                <tr>

                    <th>Title</th>
                    <th>Category</th>
                    <th>Priority</th>
                    <th>Status</th>
                    <th>Due Date</th>
                    <th class="text-center" style="width:220px;">
                        Actions
                    </th>

                </tr>

            </thead>

            <tbody>

                @if (!Model.Tasks.Any())
                {
                    <tr>

                        <td colspan="6"
                            class="text-center py-5 text-muted">

                            No tasks found.

                        </td>

                    </tr>
                }
                else
                {
                    @foreach (var task in Model.Tasks)
                    {
                        <tr>

                            <td class="fw-semibold">
                                @task.Title
                            </td>

                            <td>
                                @task.Category
                            </td>

                            <td>

                                @if (task.Priority == "High")
                                {
                                    <span class="badge rounded-pill"
                                          style="background:#FEE2E2;color:#B91C1C;padding:8px 12px;">
                                        High
                                    </span>
                                }
                                else if (task.Priority == "Medium")
                                {
                                    <span class="badge rounded-pill"
                                          style="background:#FEF3C7;color:#B45309;padding:8px 12px;">
                                        Medium
                                    </span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill"
                                          style="background:#DCFCE7;color:#15803D;padding:8px 12px;">
                                        Low
                                    </span>
                                }

                            </td>

                            <td>

                                @if (task.Status == "Pending")
                                {
                                    <span class="badge rounded-pill"
                                          style="background:#FEF3C7;color:#B45309;padding:8px 12px;">
                                        Pending
                                    </span>
                                }
                                else if (task.Status == "In Progress")
                                {
                                    <span class="badge rounded-pill"
                                          style="background:#DBEAFE;color:#2563EB;padding:8px 12px;">
                                        In Progress
                                    </span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill"
                                          style="background:#DCFCE7;color:#15803D;padding:8px 12px;">
                                        Completed
                                    </span>
                                }

                            </td>

                            <td>
                                @task.DueDate.ToString("MMM dd, yyyy")
                            </td>

                            <td>

                                <div class="d-flex justify-content-center gap-2">

                                    <a asp-action="Details"
                                       asp-route-id="@task.TaskId"
                                       class="btn action-btn action-view"
                                       title="View">

                                        <i class="bi bi-eye"></i>

                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@task.TaskId"
                                       class="btn action-btn action-edit"
                                       title="Edit">

                                        <i class="bi bi-pencil-square"></i>

                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@task.TaskId"
                                       class="btn action-btn action-delete"
                                       title="Delete">

                                        <i class="bi bi-trash"></i>

                                    </a>

                                </div>

                            </td>

                        </tr>
                    }
                }

            </tbody>

        </table>

    </div>

</div>