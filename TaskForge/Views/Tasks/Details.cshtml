@model TaskForge.ViewModels.TaskDetailsViewModel

@{
    ViewData["Title"] = "Task Details";
    Layout = "_DashboardLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>

        <h2 class="fw-bold mb-1">
            Task Details
        </h2>

        <p class="text-muted mb-0">
            View complete information about this task.
        </p>

    </div>

    <div>

        <a asp-action="Index"
           class="btn btn-outline-secondary me-2">

            <i class="bi bi-arrow-left me-1"></i>

            Back

        </a>

        <a asp-action="Edit"
           asp-route-id="@Model.TaskId"
           class="btn btn-primary">

            <i class="bi bi-pencil-square me-1"></i>

            Edit

        </a>

    </div>

</div>

<div class="card shadow-sm border-0">

    <div class="card-body p-4">

        <!-- Title -->

        <h3 class="fw-bold mb-1">

            @Model.Title

        </h3>

        <p class="text-muted">

            Created on
            @Model.DateCreated.ToString("MMMM dd, yyyy")

        </p>

        <hr />

        <!-- Information Cards -->

        <div class="row g-3 mb-4">

            <div class="col-md-4">

                <div class="border rounded-3 p-3 h-100">

                    <small class="text-muted">

                        <i class="bi bi-folder2-open me-1"></i>

                        Category

                    </small>

                    <h6 class="mt-2 mb-0">

                        @Model.Category

                    </h6>

                </div>

            </div>

            <div class="col-md-4">

                <div class="border rounded-3 p-3 h-100">

                    <small class="text-muted">

                        <i class="bi bi-flag me-1"></i>

                        Priority

                    </small>

                    <div class="mt-2">

                        @if (Model.Priority == "High")
                        {
                            <span class="badge rounded-pill"
                                  style="background:#FEE2E2;color:#B91C1C;padding:8px 14px;">
                                High
                            </span>
                        }
                        else if (Model.Priority == "Medium")
                        {
                            <span class="badge rounded-pill"
                                  style="background:#FEF3C7;color:#B45309;padding:8px 14px;">
                                Medium
                            </span>
                        }
                        else
                        {
                            <span class="badge rounded-pill"
                                  style="background:#DCFCE7;color:#15803D;padding:8px 14px;">
                                Low
                            </span>
                        }

                    </div>

                </div>

            </div>

            <div class="col-md-4">

                <div class="border rounded-3 p-3 h-100">

                    <small class="text-muted">

                        <i class="bi bi-check-circle me-1"></i>

                        Status

                    </small>

                    <div class="mt-2">

                        @if (Model.Status == "Pending")
                        {
                            <span class="badge rounded-pill"
                                  style="background:#FEF3C7;color:#B45309;padding:8px 14px;">
                                Pending
                            </span>
                        }
                        else if (Model.Status == "In Progress")
                        {
                            <span class="badge rounded-pill"
                                  style="background:#DBEAFE;color:#2563EB;padding:8px 14px;">
                                In Progress
                            </span>
                        }
                        else
                        {
                            <span class="badge rounded-pill"
                                  style="background:#DCFCE7;color:#15803D;padding:8px 14px;">
                                Completed
                            </span>
                        }

                    </div>

                </div>

            </div>

        </div>

        <!-- Due Date -->

        <div class="border rounded-3 p-3 mb-4">

            <small class="text-muted">

                <i class="bi bi-calendar-event me-1"></i>

                Due Date

            </small>

            <h6 class="mt-2 mb-0">

                @Model.DueDate.ToString("MMMM dd, yyyy")

            </h6>

        </div>

        <!-- Description -->

        <div class="border rounded-3 p-3">

            <small class="text-muted">

                <i class="bi bi-card-text me-1"></i>

                Description

            </small>

            <p class="mt-3 mb-0">

                @(string.IsNullOrWhiteSpace(Model.Description)
                    ? "No description provided."
                    : Model.Description)

            </p>

        </div>

    </div>

</div>