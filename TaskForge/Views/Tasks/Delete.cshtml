@model TaskForge.ViewModels.TaskDetailsViewModel

@{
    ViewData["Title"] = "Delete Task";
    Layout = "_DashboardLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>

        <h2 class="fw-bold text-danger">
            Delete Task
        </h2>

        <p class="text-muted mb-0">
            This action cannot be undone.
        </p>

    </div>

    <a asp-action="Index" class="btn btn-outline-secondary">
        Cancel
    </a>

</div>

<div class="card border-danger shadow-sm">

    <div class="card-body p-4">

        <h4 class="fw-bold mb-3">
            @Model.Title
        </h4>

        <p class="text-muted">
            @Model.Description
        </p>

        <hr />

        <p><strong>Category:</strong> @Model.Category</p>
        <p><strong>Priority:</strong> @Model.Priority</p>
        <p><strong>Status:</strong> @Model.Status</p>
        <p><strong>Due Date:</strong> @Model.DueDate.ToString("MMMM dd, yyyy")</p>

        <form asp-action="DeleteConfirmed" method="post">

            <input type="hidden" name="id" value="@Model.TaskId" />

            <button type="submit" class="btn btn-danger">
                Yes, Delete
            </button>

        </form>

    </div>

</div>