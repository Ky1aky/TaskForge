@{
    ViewData["Title"] = "Welcome";
}

<section class="hero-section">

    <div class="container">

        <div class="row align-items-center">

            <!-- Left Side -->
            <div class="col-lg-6">

                <h1 class="display-4 hero-title mb-3">

                    Organize your tasks.
                    <br />
                    Achieve more with
                    <span style="color:#2563EB;">TaskForge</span>

                </h1>

                <p class="lead hero-subtitle mb-4">

                    TaskForge helps you organize your daily tasks,
                    manage priorities, monitor progress, and stay productive—
                    all in one place.

                </p>

                <a asp-controller="Account"
                   asp-action="Register"
                   class="btn btn-primary btn-lg me-2">

                    Get Started

                </a>

                <a asp-controller="Account"
                   asp-action="Login"
                   class="btn btn-outline-primary btn-lg">

                    Login

                </a>

            </div>

            <!-- Right Side -->
            <div class="col-lg-6 text-center">

                <img src="~/images/hero-image.png"
                     class="img-fluid hero-image"
                     style="max-height:450px;"
                     alt="TaskForge Productivity Illustration" />

            </div>

        </div>

    </div>

</section>

<hr class="my-5" />

<section class="container">

    <div class="row g-4">

        <div class="col-md-3">

            <div class="card h-100 p-4">

                <h4>📝</h4>

                <h5>Task Management</h5>

                <p class="text-secondary">

                    Create, edit, and organize tasks easily.

                </p>

            </div>

        </div>

        <div class="col-md-3">

            <div class="card feature-card h-100 p-4">

                <h4>📂</h4>

                <h5>Categories</h5>

                <p class="text-secondary">

                    Organize tasks into meaningful categories.

                </p>

            </div>

        </div>

        <div class="col-md-3">

            <div class="card feature-card h-100 p-4">

                <h4>🔥</h4>

                <h5>Priorities</h5>

                <p class="text-secondary">

                    Focus on what matters most.

                </p>

            </div>

        </div>

        <div class="col-md-3">

            <div class="card feature-card h-100 p-4">

                <h4>📊</h4>

                <h5>Dashboard</h5>

                <p class="text-secondary">

                    Monitor your productivity at a glance.

                </p>

            </div>

        </div>

    </div>

</section>