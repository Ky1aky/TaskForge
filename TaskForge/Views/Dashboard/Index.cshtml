@model TaskForge.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
    Layout = "_DashboardLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2 class="fw-bold mb-1">
            Welcome, @Model.FullName 👋
        </h2>

        <p class="text-muted mb-0">
            Here's an overview of your productivity.
        </p>
    </div>

    <a asp-controller="Tasks"
       asp-action="Create"
       class="btn btn-primary">

        + Create Task

    </a>

</div>

<!-- Statistics Cards -->

<div class="row g-4 mb-4">

    <div class="col-lg-3 col-md-6">

        <div class="card border-0 shadow-sm h-100">

            <div class="card-body d-flex justify-content-between align-items-center">

                <div>

                    <small class="text-muted d-block">
                        Total Tasks
                    </small>

                    <h2 class="fw-bold mb-0">
                        @Model.TotalTasks
                    </h2>

                </div>

                <div class="fs-1">
                    📋
                </div>

            </div>

        </div>

    </div>

    <div class="col-lg-3 col-md-6">

        <div class="card border-0 shadow-sm h-100">

            <div class="card-body d-flex justify-content-between align-items-center">

                <div>

                    <small class="text-muted d-block">
                        Pending
                    </small>

                    <h2 class="fw-bold text-warning mb-0">
                        @Model.PendingTasks
                    </h2>

                </div>

                <div class="fs-1">
                    ⏳
                </div>

            </div>

        </div>

    </div>

    <div class="col-lg-3 col-md-6">

        <div class="card border-0 shadow-sm h-100">

            <div class="card-body d-flex justify-content-between align-items-center">

                <div>

                    <small class="text-muted d-block">
                        In Progress
                    </small>

                    <h2 class="fw-bold text-primary mb-0">
                        @Model.InProgressTasks
                    </h2>

                </div>

                <div class="fs-1">
                    🚧
                </div>

            </div>

        </div>

    </div>

    <div class="col-lg-3 col-md-6">

        <div class="card border-0 shadow-sm h-100">

            <div class="card-body d-flex justify-content-between align-items-center">

                <div>

                    <small class="text-muted d-block">
                        Completed
                    </small>

                    <h2 class="fw-bold text-success mb-0">
                        @Model.CompletedTasks
                    </h2>

                </div>

                <div class="fs-1">
                    ✅
                </div>

            </div>

        </div>

    </div>

</div>

<!-- Recent Tasks -->

<div class="card shadow-sm border-0">

    <div class="card-header bg-white">

        <h5 class="mb-0 fw-semibold">

            Recent Tasks

        </h5>

    </div>

    <div class="card-body p-0">

        @if (!Model.RecentTasks.Any())
        {
            <div class="p-4 text-center text-muted">

                You haven't created any tasks yet.

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover mb-0">

                    <thead class="table-light">

                        <tr>

                            <th>Title</th>
                            <th>Category</th>
                            <th>Priority</th>
                            <th>Status</th>
                            <th>Due Date</th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var task in Model.RecentTasks)
                        {
                            <tr>

                                <td>@task.Title</td>

                                <td>@task.Category</td>

                                <td>@task.Priority</td>

                                <td>@task.Status</td>

                                <td>@task.DueDate.ToString("MMM dd, yyyy")</td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>