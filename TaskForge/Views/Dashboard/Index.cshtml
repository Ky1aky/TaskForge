@{
    ViewData["Title"] = "Dashboard";
    Layout = "_DashboardLayout";

    var hour = DateTime.Now.Hour;

    var greeting = "";

    if (hour < 12)
    {
        greeting = "Good Morning";
    }
    else if (hour < 18)
    {
        greeting = "Good Afternoon";
    }
    else
    {
        greeting = "Good Evening";
    }
}

<div class="mb-4">

    <h2 class="fw-bold">

        @greeting,
        @User.Identity?.Name 👋

    </h2>

    <p class="text-muted">

        Here's your productivity summary.

    </p>

</div>

<div class="row g-4">

    <div class="col-md-3">

        <div class="card text-center p-4">

            <h6>Total Tasks</h6>

            <h2 class="fw-bold">0</h2>

        </div>

    </div>

    <div class="col-md-3">

        <div class="card text-center p-4">

            <h6>Pending</h6>

            <h2 class="fw-bold text-warning">0</h2>

        </div>

    </div>

    <div class="col-md-3">

        <div class="card text-center p-4">

            <h6>In Progress</h6>

            <h2 class="fw-bold text-primary">0</h2>

        </div>

    </div>

    <div class="col-md-3">

        <div class="card text-center p-4">

            <h6>Completed</h6>

            <h2 class="fw-bold text-success">0</h2>

        </div>

    </div>

</div>

<div class="card mt-4 p-4">

    <h4>

        Task Completion Progress

    </h4>

    <div class="progress mt-3">

        <div class="progress-bar"
             role="progressbar"
             style="width:0%">

            0%

        </div>

    </div>

</div>

<div class="card mt-4 p-4">

    <h4>

        Recent Tasks

    </h4>

    <hr />

    <p class="text-muted">

        No tasks yet.

        <br />

        Click "Create Task" to get started.

    </p>

</div>