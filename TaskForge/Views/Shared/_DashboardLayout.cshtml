<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - TaskForge</title>

    <!-- Google Font -->
    <link rel="preconnect"
          href="https://fonts.googleapis.com">

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
          rel="stylesheet">

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Site CSS -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

</head>

<body class="bg-light">

    <!-- ========================= HEADER ========================= -->

    <header class="bg-white border-bottom shadow-sm">

        <div class="container-fluid">

            <div class="d-flex justify-content-between align-items-center py-3 px-4">

                <!-- Logo -->

                <a asp-controller="Dashboard"
                   asp-action="Index">

                    <img src="~/images/logo-navbar.png"
                         alt="TaskForge"
                         style="height:55px;" />

                </a>

                <!-- Right Side -->

                <div class="d-flex align-items-center">

                    <span class="me-3 fw-semibold">

                        Welcome,
                        @User.Identity?.Name

                    </span>

                    <a asp-controller="Account"
                       asp-action="Logout"
                       class="btn btn-outline-danger">

                        Logout

                    </a>

                </div>

            </div>

        </div>

    </header>

    <!-- ========================= MAIN ========================= -->

    <div class="container-fluid">

        <div class="row">

            <!-- Sidebar -->

            <aside class="col-lg-2 col-md-3 bg-white border-end vh-100">

                <nav class="nav flex-column py-4">

                    <a asp-controller="Dashboard"
                       asp-action="Index"
                       class="nav-link">

                        <i class="bi bi-speedometer2 me-2"></i>
                        Dashboard

                    </a>

                    <a asp-controller="Tasks"
                       asp-action="Index"
                       class="nav-link">

                        <i class="bi bi-list-check me-2"></i>
                        Tasks

                    </a>

                    <li class="nav-item">
                        <a asp-controller="Profile"
                           asp-action="Index"
                           class="nav-link">
                            <i class="bi bi-person me-2"></i>
                            Profile
                        </a>
                    </li>

                </nav>

            </aside>

            <!-- Page -->

            <main class="col-lg-10 col-md-9 p-4">

                @if (TempData["Success"] != null)
                {
                    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index:1080;">

                        <div id="successToast"
                             class="toast align-items-center text-bg-success border-0"
                             role="alert"
                             data-bs-delay="3000">

                            <div class="d-flex">

                                <div class="toast-body">

                                    <i class="bi bi-check-circle-fill me-2"></i>

                                    @TempData["Success"]

                                </div>

                                <button type="button"
                                        class="btn-close btn-close-white me-2 m-auto"
                                        data-bs-dismiss="toast">
                                </button>

                            </div>

                        </div>

                    </div>
                }

                @RenderBody()

            </main>

        </div>

    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
        document.addEventListener("DOMContentLoaded", function () {

        var toastElement = document.getElementById("successToast");

        if (toastElement) {

        var toast = new bootstrap.Toast(toastElement);

        toast.show();

        }

        });
    </script>

</body>

</html>